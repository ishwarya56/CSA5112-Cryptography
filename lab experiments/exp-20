
#include <stdio.h>
#include <string.h>
#include <openssl/des.h>

void display(char *name, DES_cblock data[], int n)
{
    int i, j;

    printf("\n%s\n", name);

    for(i = 0; i < n; i++)
    {
        printf("Block %d: ", i + 1);

        for(j = 0; j < 8; j++)
            printf("%02X ", data[i][j]);

        printf("\n");
    }
}

int main()
{
    DES_cblock key = "12345678";
    DES_cblock iv1 = "ABCDEFGH";
    DES_cblock iv2 = "ABCDEFGH";

    DES_key_schedule ks;

    DES_cblock plain[3] = {
        "BLOCK001",
        "BLOCK002",
        "BLOCK003"
    };

    DES_cblock ecb[3], ecb_dec[3];
    DES_cblock cbc[3], cbc_dec[3];

    int i;

    DES_set_key_unchecked(&key, &ks);

    // ECB Encryption
    for(i = 0; i < 3; i++)
        DES_ecb_encrypt(&plain[i], &ecb[i],
                        &ks, DES_ENCRYPT);

    // CBC Encryption
    DES_ncbc_encrypt(
        (unsigned char *)plain,
        (unsigned char *)cbc,
        24, &ks, &iv1, DES_ENCRYPT
    );

    display("Original ECB Ciphertext", ecb, 3);
    display("Original CBC Ciphertext", cbc, 3);

    // Introduce one-bit error in first ciphertext block
    ecb[0][0] ^= 0x01;
    cbc[0][0] ^= 0x01;

    // ECB Decryption
    for(i = 0; i < 3; i++)
        DES_ecb_encrypt(&ecb[i], &ecb_dec[i],
                        &ks, DES_DECRYPT);

    // CBC Decryption
    DES_ncbc_encrypt(
        (unsigned char *)cbc,
        (unsigned char *)cbc_dec,
        24, &ks, &iv2, DES_DECRYPT
    );

    display("ECB Decrypted Blocks After Error",
            ecb_dec, 3);

    display("CBC Decrypted Blocks After Error",
            cbc_dec, 3);

    return 0;
}
