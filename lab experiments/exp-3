#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main() {
    char text[100], key[100];
    int i, j = 0;
    printf("Enter the plaintext: ");
    fgets(text, sizeof(text), stdin);
    printf("Enter the key: ");
    scanf("%s", key);
    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            if (isupper(text[i]))
                text[i] = ((text[i] - 'A') +
                           (toupper(key[j % strlen(key)]) - 'A')) % 26 + 'A';
            else
                text[i] = ((text[i] - 'a') +
                           (tolower(key[j % strlen(key)]) - 'a')) % 26 + 'a';
            j++;
        }
    }
    printf("Encrypted text: %s", text);
    return 0;
}
