
#include <stdio.h>
#include <string.h>

int main() {
    char text[1000];
    char output[1000];
    int i, k, top;

    printf("Enter ciphertext: ");
    scanf("%999s", text);

    printf("Enter number of possible plaintexts: ");
    scanf("%d", &top);

    if (top < 1) return 0;
    if (top > 26) top = 26;

    for (k = 0; k < top; k++) {
        for (i = 0; text[i] != '\0'; i++) {
            char ch = text[i];

            if (ch >= 'A' && ch <= 'Z')
                output[i] = (ch - 'A' - k + 26) % 26 + 'A';
            else if (ch >= 'a' && ch <= 'z')
                output[i] = (ch - 'a' - k + 26) % 26 + 'a';
            else
                output[i] = ch;
        }

        output[i] = '\0';

        printf("\nKey = %d : %s", k, output);
    }

    return 0;
}
