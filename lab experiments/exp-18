
#include <stdio.h>

int PC1[56] = {
57,49,41,33,25,17,9,1,58,50,42,34,26,18,
10,2,59,51,43,35,27,19,11,3,60,52,44,36,
63,55,47,39,31,23,15,7,62,54,46,38,30,22,
14,6,61,53,45,37,29,21,13,5,28,20,12,4
};

int PC2[48] = {
14,17,11,24,1,5,3,28,15,6,21,10,
23,19,12,4,26,8,16,7,27,20,13,2,
41,52,31,37,47,55,30,40,51,45,33,48,
44,49,39,56,34,53,46,42,50,36,29,32
};

int shifts[16] = {
1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1
};

void leftShift(int *a, int n)
{
    int temp[28], i;

    for(i = 0; i < 28; i++)
        temp[i] = a[(i+n)%28];

    for(i = 0; i < 28; i++)
        a[i] = temp[i];
}

int main()
{
    char key[65];
    int bits[64], perm[56];
    int C[28], D[28], subkey[48];
    int i, r;

    printf("Enter 64-bit binary key:\n");
    scanf("%64s", key);

    for(i = 0; i < 64; i++)
    {
        if(key[i] != '0' && key[i] != '1')
        {
            printf("Invalid binary key!\n");
            return 1;
        }
        bits[i] = key[i] - '0';
    }

    for(i = 0; i < 56; i++)
        perm[i] = bits[PC1[i]-1];

    for(i = 0; i < 28; i++)
    {
        C[i] = perm[i];
        D[i] = perm[i+28];
    }

    for(r = 0; r < 16; r++)
    {
        leftShift(C, shifts[r]);
        leftShift(D, shifts[r]);

        for(i = 0; i < 48; i++)
        {
            if(PC2[i] <= 28)
                subkey[i] = C[PC2[i]-1];
            else
                subkey[i] = D[PC2[i]-29];
        }

        printf("\nK%d = ", r+1);

        for(i = 0; i < 48; i++)
            printf("%d", subkey[i]);
    }

    return 0;
}
