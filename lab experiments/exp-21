#include <stdio.h>

int main() {
    int i, n, block = 4;
    int p[20], c[20], key = 5, iv = 7;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter plaintext blocks: ");
    for(i = 0; i < n; i++)
        scanf("%d", &p[i]);

    // ECB
    printf("\nECB: ");
    for(i = 0; i < n; i++) {
        c[i] = p[i] ^ key;
        printf("%d ", c[i]);
    }

    // CBC
    printf("\nCBC: ");
    for(i = 0; i < n; i++) {
        c[i] = p[i] ^ key ^ (i == 0 ? iv : c[i-1]);
        printf("%d ", c[i]);
    }

    // CFB (simplified)
    printf("\nCFB: ");
    int feedback = iv;
    for(i = 0; i < n; i++) {
        c[i] = p[i] ^ (feedback ^ key);
        feedback = c[i];
        printf("%d ", c[i]);
    }

    return 0;
}
