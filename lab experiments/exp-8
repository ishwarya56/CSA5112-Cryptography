
#include <stdio.h>
#include <ctype.h>

int main(void) {
    char text[200];
    char key[] = "CIPHERABDFGJKLMNOQSTUVWXYZ";

    printf("Enter plaintext: ");
    if (!fgets(text, sizeof(text), stdin))
        return 1;

    printf("Ciphertext: ");
    for (int i = 0; text[i] != '\0'; i++) {
        unsigned char ch = (unsigned char)text[i];

        if (isalpha(ch)) {
            int index = toupper(ch) - 'A';
            char result = key[index];

            putchar(islower(ch) ? tolower(result) : result);
        } else {
            putchar(ch);
        }
    }
    return 0;
}
