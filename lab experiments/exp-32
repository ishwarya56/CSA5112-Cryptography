
#include <stdio.h>

int main() {
    int p = 23, q = 11, g = 4;
    int x = 3;
    int h = 5;
    int k1 = 2, k2 = 3;
    int r1, s1, r2, s2;
    int y = 0, i;

    // Public key
    for (i = 0; i < x; i++)
        y = (y * g) % p;

    printf("Public key y = %d\n", y);

    // First signature
    r1 = 1;
    for (i = 0; i < k1; i++)
        r1 = (r1 * g) % p;
    r1 %= q;

    s1 = (k1 * (h + x * r1)) % q;

    // Second signature
    r2 = 1;
    for (i = 0; i < k2; i++)
        r2 = (r2 * g) % p;
    r2 %= q;

    s2 = (k2 * (h + x * r2)) % q;

    printf("\nFirst signature: (%d, %d)", r1, s1);
    printf("\nSecond signature: (%d, %d)", r2, s2);

    if (r1 != r2 || s1 != s2)
        printf("\nSignatures are different.");

    return 0;
}
