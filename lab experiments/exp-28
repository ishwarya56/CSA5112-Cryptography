#include <stdio.h>

int power(int a, int b, int mod) {
    int r = 1;
    while(b > 0) {
        r = (r * a) % mod;
        b--;
    }
    return r;
}

int main() {
    int q = 23, g = 5;
    int x = 6, y = 15;
    int A, B, k1, k2;

    A = power(g, x, q);
    B = power(g, y, q);

    k1 = power(B, x, q);
    k2 = power(A, y, q);

    printf("Alice public = %d\n", A);
    printf("Bob public = %d\n", B);
    printf("Alice key = %d\n", k1);
    printf("Bob key = %d\n", k2);

    return 0;
}
