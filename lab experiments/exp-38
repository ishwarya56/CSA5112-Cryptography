
#include <stdio.h>

int mod(int x) {
    return (x % 26 + 26) % 26;
}

int inverse(int x) {
    for (int i = 1; i < 26; i++)
        if (mod(x * i) == 1)
            return i;
    return -1;
}

int main() {
    int p[2][2], c[2][2], d, inv;
    int a, b, e, f;

    printf("Enter plaintext matrix (2x2):\n");
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &p[i][j]);

    printf("Enter ciphertext matrix (2x2):\n");
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &c[i][j]);

    d = mod(p[0][0]*p[1][1] -
            p[0][1]*p[1][0]);

    inv = inverse(d);

    if (inv == -1) {
        printf("Inverse does not exist.");
        return 0;
    }

    a = mod(inv * p[1][1]);
    b = mod(-inv * p[0][1]);
    e = mod(-inv * p[1][0]);
    f = mod(inv * p[0][0]);

    printf("\nRecovered Hill Key:\n");

    printf("%d %d\n", mod(c[0][0]*a +
           c[0][1]*e),
           mod(c[0][0]*b + c[0][1]*f));

    printf("%d %d\n", mod(c[1][0]*a +
           c[1][1]*e),
           mod(c[1][0]*b + c[1][1]*f));

    return 0;
}
