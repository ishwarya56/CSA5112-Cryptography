
#include <stdio.h>
#include <string.h>
#include <openssl/des.h>

int main()
{
    DES_cblock key1 = "12345678";
    DES_cblock key2 = "ABCDEFGH";
    DES_cblock key3 = "87654321";
    DES_cblock iv = "12345678";

    DES_key_schedule ks1, ks2, ks3;

    unsigned char plaintext[100];
    unsigned char ciphertext[112];

    int len, padded, i;

    printf("Enter plaintext: ");
    fgets((char *)plaintext, sizeof(plaintext), stdin);

    len = strlen((char *)plaintext);

    if(len > 99)
    {
        printf("Plaintext too long!\n");
        return 1;
    }

    if(len == 0)
        return 1;

    padded = ((len + 7) / 8) * 8;

    for(i = len; i < padded; i++)
        plaintext[i] = padded - len;

    DES_set_key_unchecked(&key1, &ks1);
    DES_set_key_unchecked(&key2, &ks2);
    DES_set_key_unchecked(&key3, &ks3);

    DES_ede3_cbc_encrypt(
        plaintext, ciphertext, padded,
        &ks1, &ks2, &ks3, &iv, DES_ENCRYPT
    );

    printf("\n3DES CBC Ciphertext:\n");

    for(i = 0; i < padded; i++)
        printf("%02X ", ciphertext[i]);

    printf("\n");

    return 0;
}
