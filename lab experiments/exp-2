#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main() {
    char text[100];
    char key[27] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i;
    printf("Enter the text: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            if (isupper(text[i]))
                text[i] = key[text[i] - 'A'];
            else
                text[i] = tolower(key[text[i] - 'a']);
        }
    }
    printf("Encrypted text: %s", text);
    return 0;
}
