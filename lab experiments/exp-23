#include <stdio.h>

int main() {
    int p[3] = {1, 2, 4};
    int counter[3] = {0, 1, 2};
    int key = 5, c[3], i;

    printf("CTR Encryption:\n");
    for(i = 0; i < 3; i++) {
        c[i] = p[i] ^ counter[i] ^ key;
        printf("%d ", c[i]);
    }

    printf("\nCTR Decryption:\n");
    for(i = 0; i < 3; i++) {
        p[i] = c[i] ^ counter[i] ^ key;
        printf("%d ", p[i]);
    }

    return 0;
}
