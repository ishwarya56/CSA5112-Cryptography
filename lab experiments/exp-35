
#include <stdio.h>
#include <string.h>

int main() {
    char p[100];
    int key[100], i, n;

    printf("Enter plaintext: ");
    scanf("%99s", p);

    n = strlen(p);

    printf("Enter %d key values (0-25):\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &key[i]);

        if (key[i] < 0 || key[i] > 25) {
            printf("Invalid key");
            return 0;
        }
    }

    printf("Ciphertext: ");

    for (i = 0; i < n; i++) {
        char c = p[i];

        if (c >= 'a' && c <= 'z')
            c -= 'a';
        else if (c >= 'A' && c <= 'Z')
            c -= 'A';
        else {
            printf("Invalid plaintext");
            return 0;
        }

        printf("%c", (c + key[i]) % 26 + 'A');
    }

    printf("\n");

    return 0;
}
