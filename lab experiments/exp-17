
#include <stdio.h>
#include <openssl/des.h>

int main()
{
    DES_cblock key = {0x13,0x34,0x57,0x79,
                      0x9B,0xBC,0xDF,0xF1};

    DES_key_schedule schedule;
    DES_cblock input = {0x85,0xE8,0x13,0x54,
                        0x0F,0x0A,0xB4,0x05};

    DES_cblock output;

    DES_set_key_unchecked(&key, &schedule);

    DES_ecb_encrypt(&input, &output,
                    &schedule, DES_DECRYPT);

    printf("Ciphertext: ");
    for(int i = 0; i < 8; i++)
        printf("%02X", input[i]);

    printf("\nDecrypted Plaintext: ");
    for(int i = 0; i < 8; i++)
        printf("%02X", output[i]);

    printf("\n");

    return 0;
}
